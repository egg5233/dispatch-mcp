#!/usr/bin/env python3
"""Read my dispatch messages.

usage: dispatch-recv [--limit N] [--priority high+] [--all] [--since <id>]
                     [--full [<id>[,<id>...]]] [--peek] [--json]

  (default)        drain up to --limit (30) unread messages, one summary line
                   each: id  time  from→to  type  priority  [flags]  first 120 chars.
                   Whatever is not drained STAYS UNREAD on the server (the
                   server only marks what it returned) — a limit never loses
                   anything, it just defers it to the next call.
  --priority P+    drain only priority P and above (low|medium|high|immediate)
  --all            no count limit (output is still capped at 64 KB; the tail
                   says what was held back and how to see it)
  --since <id>     show everything after message <id> (non-destructive)
  --full           show full bodies instead of one-liners for this drain
  --full <ids>     print those messages in full (no drain; comma-separated)
  --peek           look without consuming (hooks use this; you rarely need it)
  --json           raw JSON instead of text

Every drained message is also appended to ~/.dispatch/spool-<handle>.jsonl,
so nothing printed here is ever the only copy.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import dispatchlib as D  # noqa: E402

USAGE = __doc__.strip()
MAXBYTES = int(os.environ.get("DISPATCH_RECV_MAXBYTES", "65536"))


def parse(argv):
    o = {"limit": 30, "priority": "low", "all": False, "since": None, "full": None,
         "full_ids": [], "peek": False, "json": False}
    i = 0
    while i < len(argv):
        a = argv[i]

        def val(name):
            nonlocal i
            if i + 1 >= len(argv):
                D.die("dispatch-recv: %s needs a value" % name, 2)
            i += 1
            return argv[i]
        if a.startswith("--") and "=" in a:
            k, v = a[2:].split("=", 1)
            argv[i] = "--" + k
            argv.insert(i + 1, v)
            continue
        if a in ("--limit", "-n"):
            v = val(a)
            if not v.isdigit():
                D.die("dispatch-recv: --limit must be a non-negative integer", 2)
            o["limit"] = int(v)
        elif a in ("--priority", "-p"):
            try:
                o["priority"] = D.parse_min_priority(val(a))
            except D.DispatchError as e:
                D.die("dispatch-recv: %s" % e, 2)
        elif a == "--all":
            o["all"] = True
        elif a == "--since":
            o["since"] = val(a)
        elif a == "--full":
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                i += 1
                if argv[i] == "all":
                    o["full"] = True
                else:
                    o["full_ids"] = [x for x in argv[i].split(",") if x]
            else:
                o["full"] = True
        elif a == "--peek":
            o["peek"] = True
        elif a == "--json":
            o["json"] = True
        elif a in ("-h", "--help"):
            print(USAGE)
            sys.exit(0)
        else:
            D.die("dispatch-recv: unknown argument '%s'\n%s" % (a, USAGE), 2)
        i += 1
    return o


def print_bounded(blocks, total, spool, note_more=None, full=False):
    """Print blocks under the byte cap; say what was held back."""
    shown, used = [], 0
    for b in blocks:
        n = len(b.encode("utf-8")) + 1
        if used + n > MAXBYTES and shown:
            break
        shown.append(b)
        used += n
    for b in shown:
        print(b)
    held = total - len(shown)
    if held > 0:
        print("")
        print("  … %d more held back by the %d-byte output cap (nothing lost — all are in the spool)." % (held, MAXBYTES))
        print("      spool: %s   (dispatch-recv --since <last id shown> replays from the server)" % spool)
    if note_more:
        print("")
        print(note_more)


def main(argv):
    o = parse(list(argv))
    handle, tok = D.identity()
    if not tok:
        D.die("dispatch-recv: no token (pane '%s' not registered, $DISPATCH_TOKEN unset)" % os.environ.get("TMUX_PANE", "?"))

    # ── --full <ids>: fetch and print, no drain ──
    if o["full_ids"]:
        rc = 0
        for mid in o["full_ids"]:
            try:
                status, d = D.http("GET", "/msg/" + mid, token=tok)
            except D.DispatchError as e:
                # fall back to the local spool
                rows = [m for m in D.spool_read(handle) if m.get("id") == mid]
                if rows:
                    print(render(rows[-1], o, True))
                    continue
                D.die("dispatch-recv: %s" % e)
            if status != 200 or not d:
                print("dispatch-recv: %s: %s" % (mid, (d or {}).get("error") or "HTTP %s" % status))
                rc = 1
                continue
            print(render(d, o, True))
        return rc

    # ── --since <id>: non-destructive history ──
    if o["since"]:
        try:
            status, d = D.http("GET", "/msg/history?since=%s&limit=%d" % (o["since"], o["limit"] if not o["all"] else 500), token=tok)
        except D.DispatchError as e:
            rows = D.spool_read(handle)
            idx = next((i for i, m in enumerate(rows) if m.get("id") == o["since"]), None)
            if idx is None:
                D.die("dispatch-recv: %s; and id %s not in local spool" % (e, o["since"]))
            ms = rows[idx + 1:]
            print("(server unreachable — replaying %d from local spool)" % len(ms))
            status, d = 200, {"messages": ms, "count": len(ms)}
        if status != 200 or not d:
            D.die("dispatch-recv: %s" % ((d or {}).get("error") or "HTTP %s" % status))
        ms = d.get("messages") or []
        if o["json"]:
            print(json.dumps(d, ensure_ascii=False))
            return 0
        if not ms:
            print("No messages after %s." % o["since"])
            return 0
        print("%d message(s) after %s:" % (len(ms), o["since"]))
        print_bounded([render(m, o) for m in ms], len(ms), D.spool_path(handle))
        return 0

    # ── default: drain (or peek) ──
    q = "/msg/recv?limit=%d&priority=%s" % (0 if o["all"] else o["limit"], o["priority"])
    if o["peek"]:
        q += "&peek=1"
    try:
        status, d = D.http("GET", q, token=tok)
    except D.DispatchError as e:
        D.die("dispatch-recv: %s" % e)
    if status != 200 or not d:
        D.die("dispatch-recv: %s" % ((d or {}).get("error") or "HTTP %s" % status))
    ms = d.get("messages") or []
    handle = d.get("handle") or handle
    if ms and not o["peek"]:
        if not D.spool_append(handle, ms):
            print("dispatch-recv: WARNING could not write spool %s — printing everything so nothing is lost." % D.spool_path(handle))
            o["all"] = True
            o["full"] = True
    if o["json"]:
        print(json.dumps(d, ensure_ascii=False))
        return 0
    remaining = d.get("remaining") or 0
    if not ms:
        if remaining:
            print("No messages at %s+; %d unread at lower priority (dispatch-recv to drain them)." % (o["priority"], remaining))
        else:
            print("No new messages.")
        return 0
    hdr = "%d message(s)" % len(ms)
    if o["peek"]:
        hdr += " (peek — still unread)"
    if o["priority"] != "low":
        hdr += " at %s+" % o["priority"]
    note = None
    if remaining:
        by = d.get("remaining_by_priority") or {}
        bys = ", ".join("%s %d" % (k, v) for k, v in by.items() if v)
        hdr += " — %d more still unread on the server" % remaining
        note = ("  %d more unread%s. They stay queued until you drain them: dispatch-recv%s"
                % (remaining, " (%s)" % bys if bys else "",
                   "" if o["priority"] == "low" else "  (this call was filtered to %s+)" % o["priority"]))
    print(hdr + ":")
    print_bounded([render(m, o) for m in ms], len(ms), D.spool_path(handle), note_more=note)
    if not o["full"]:
        long_ones = [m for m in ms if len(" ".join((m.get("body") or "").split())) > 120]
        if long_ones:
            print("  full text: dispatch-recv --full %s" % ",".join(m["id"] for m in long_ones[:5]) + ("  (or --full all on the next drain)" if len(long_ones) > 5 else ""))
    return 0


def render(m, o, force_full=False):
    if force_full or o["full"]:
        return D.render_full(m) + "\n"
    return D.summary_line(m)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
